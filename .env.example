# Copy to .env — never commit the copy.
POSTGRES_USER=ecowatch
POSTGRES_PASSWORD=ecowatch_dev
POSTGRES_DB=ecowatch
POSTGRES_PORT=5433
# SQLAlchemy URL used by the backend (host dev)
DATABASE_URL=postgresql+psycopg://ecowatch:ecowatch_dev@localhost:5433/ecowatch

# Set a strong random value before deploying. Required when ECOWATCH_ENV=production.
ECOWATCH_AUTH_SECRET=replace-with-strong-random-value

# Login throttling (per normalised email + client IP, DB-backed)
ECOWATCH_LOGIN_MAX_ATTEMPTS=5
ECOWATCH_LOGIN_WINDOW_SECONDS=300
ECOWATCH_LOGIN_LOCKOUT_SECONDS=900
