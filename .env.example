# Copy to .env — never commit the copy.
POSTGRES_USER=ecowatch
POSTGRES_PASSWORD=ecowatch_dev
POSTGRES_DB=ecowatch
POSTGRES_PORT=5433
# SQLAlchemy URL used by the backend (host dev)
DATABASE_URL=postgresql+psycopg://ecowatch:ecowatch_dev@localhost:5433/ecowatch

# Set a strong random value before deploying. Required when ECOWATCH_ENV=production.
ECOWATCH_AUTH_SECRET=replace-with-strong-random-value

# The API process runs the job worker locally so queued jobs actually execute.
# Leave enabled during development and on an intranet; only disable when a
# separate worker process is deployed.
ECOWATCH_WORKER_ENABLED=true

# Login throttling (per normalised email + client IP, DB-backed)
ECOWATCH_LOGIN_MAX_ATTEMPTS=5
ECOWATCH_LOGIN_WINDOW_SECONDS=300
ECOWATCH_LOGIN_LOCKOUT_SECONDS=900

# Optional database pooling, query timeout, and API limits
ECOWATCH_DB_POOL_SIZE=10
ECOWATCH_DB_MAX_OVERFLOW=10
ECOWATCH_DB_POOL_TIMEOUT_SECONDS=30
ECOWATCH_DB_POOL_RECYCLE_SECONDS=1800
ECOWATCH_DB_STATEMENT_TIMEOUT_MS=15000
ECOWATCH_MAX_JSON_BODY_BYTES=2097152
ECOWATCH_MAX_UPLOAD_BYTES=15728640
ECOWATCH_REQUEST_TIMEOUT_SECONDS=30
ECOWATCH_MAX_CONCURRENT_REQUESTS=200
ECOWATCH_GZIP_MINIMUM_SIZE=500

# Optional endpoint rate limits
ECOWATCH_UPLOAD_RATE_LIMIT=30
ECOWATCH_UPLOAD_WINDOW_SECONDS=60
ECOWATCH_EXPENSIVE_ENDPOINT_RATE_LIMIT=20
ECOWATCH_EXPENSIVE_ENDPOINT_WINDOW_SECONDS=60
ECOWATCH_MESSAGING_RATE_LIMIT=30
ECOWATCH_MESSAGING_WINDOW_SECONDS=60
ECOWATCH_PUBLIC_API_BURST_LIMIT=120
ECOWATCH_PUBLIC_API_BURST_WINDOW_SECONDS=60
