{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "./node_modules/.bin/esbuild tests/frontend_core.test.ts --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.test-dist/frontend_core.test.mjs && node --test .test-dist/frontend_core.test.mjs",
    "test:release": "node --test tests/release_smoke.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^6.2.7"
  }
}
